        -160
      ],
      "id": "45306c64-d06b-48eb-a999-2e796879ab7e",
      "name": "Remove Duplicate Product IDs"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const p = item.json;\n\n  return {\n    json: {\n      dataset_key: $('Get active dataset').first().json.active_dataset_key,\n      product_id: $('Loop Over Items').first().json.product_id,\n      extraction_date: new Date().toISOString(),\n      last_sync: new Date().toISOString(),\n\n      status: p.status ?? null,\n      domain_id: p.domain_id ?? null,\n      catalog_product_id: p.id ?? null,\n      name: p.name ?? null,\n      family_name: p.family_name ?? null,\n      buy_box_winner_item_id: p.buy_box_winner?.item_id ?? null,\n      attributes: p.attributes ?? [],\n      pictures: p.pictures ?? [],\n      main_features: p.main_features ?? [],\n      short_description: p.short_description ?? {},\n      raw_json: p\n    }\n  };\n});"
      },
