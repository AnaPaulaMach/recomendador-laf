    {
      "parameters": {
        "jsCode": "const seen = new Set();\n\nreturn items.filter(item => {\n  const product = item.json.product_id;\n\n  if (seen.has(product)) {\n    return false;\n  }\n\n  seen.add(product);\n  return true;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
