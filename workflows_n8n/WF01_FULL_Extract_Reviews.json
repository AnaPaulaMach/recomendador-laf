    {
      "parameters": {
        "jsCode": "\nconst seen = new Set();\nreturn items.filter(item => {\n  const product = item.json.product_id;\n  if (seen.has(product)) return false;  // descarta todos los demás\n  seen.add(product);\n  return true;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        -16
      ],
      "id": "68fb253a-e007-4826-aab2-1d3f8f390595",
      "name": "Keep One Item Per Product"
    },
    {
      "parameters": {
        "jsCode": "const input = items[0].json;\n\nconst reviews = input.reviews ?? [];\nconst productId = input.product_id;\nconst itemId = input.item_id;\n\nif (!reviews.length) {\n  return [];\n}\n\nreturn reviews.map(r => ({\n  json: {\n    ...r,\n    product_id: productId,\n    item_id: itemId\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        80
      ],
      "id": "f1b00abd-b1cb-41d1-a457-9111a52fdfa7",
      "name": "Split Reviews"
    },
    {
      "parameters": {
        "jsCode": "const datasetKey = $('Get Active Dataset').first().json.active_dataset_key;\n\nreturn items.map(item => {\n  const r = item.json;\n\n  return {\n    json: {\n      dataset_key: datasetKey,\n      review_id: String(r.id),\n      product_id: r.product_id,\n      item_id: r.item_id,\n      extraction_date: new Date().toISOString(),\n      last_sync: new Date().toISOString(),\n      date_created: r.date_created ?? null,\n      buying_date: r.buying_date ?? null,\n      rate: r.rate ?? null,\n      title: r.title ?? null,\n      content: r.content ?? null,\n      likes: r.likes ?? null,\n      dislikes: r.dislikes ?? null,\n      relevance: r.relevance ?? null,\n      reviewer_id: r.reviewer_id ?? null,\n      reviewable_object: r.reviewable_object ?? {},\n      valorization: r.valorization ?? {},\n      forbidden_words: r.forbidden_words ?? [],\n      attributes: r.attributes ?? [],\n      media: r.media ?? [],\n      reactions: r.reactions ?? {},\n      attributes_variation: r.attributes_variation ?? [],\n      translations: r.translations ?? {},\n      item_condition: r.condition ?? null,\n      catalog_listing: r.catalog_listing ?? null,\n      variation_id: r.variation_id != null ? String(r.variation_id) : null,\n      has_order_id: r.order_id != null,\n      item_status: r.item_status ?? null\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        80
      ],
      "id": "61e6e718-b20d-4da5-869a-270f51cff365",
      "name": "Build Reviews RAW Row"
