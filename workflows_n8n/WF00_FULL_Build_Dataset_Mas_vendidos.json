        "jsCode": "const root = $input.first().json;\n\nconst categoryId = root.query_data?.id || \"\";\nconst content = root.content || [];\n\nreturn content.map(item => ({\n  json: {\n    site_id: categoryId.startsWith(\"MLA\") ? \"MLA\" : categoryId.startsWith(\"MLB\") ? \"MLB\" : \"\",\n    category_id: categoryId,\n    highlight_id: item.id,\n    position: item.position,\n    type: item.type\n  }\n}));\n\n"
      },
