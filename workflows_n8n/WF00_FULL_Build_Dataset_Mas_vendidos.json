    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst stamp = now.toISOString().replace(/[-:]/g, '').replace('T', '_').slice(0, 15);\n\nconst input = $input.first().json;\n\nreturn [{\n  json: {\n    site_id: input.site_id,\n    category_id: input.category_id,\n    category_label: input.category_label,\n    dataset_key: `${input.site_id.toLowerCase()}_${input.category_id.toLowerCase()}_${stamp}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        624
      ],
      "id": "e1fe6e34-48a1-4057-8131-3ae68e12225a",
      "name": "Build Dataset Key"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const j = item.json;\n\n  return {\n    json: {\n      dataset_key: $('Build Dataset Key').item.json.dataset_key,\n      product_id: j.product_id ?? null,\n      item_id: j.item_id,\n      extraction_date: new Date().toISOString(),\n      last_sync: new Date().toISOString(),\n\n      type: j.type ?? null,\n      site_id: j.site_id ?? null,\n      seller_id: j.seller_id ?? null,\n      accepts_mercadopago: j.accepts_mercadopago ?? null,\n      price: j.price ?? null,\n      category_id: j.category_id ?? null,\n      currency_id: j.currency_id ?? null,\n      warranty: j.warranty ?? null,\n      condition: j.condition ?? null,\n      listing_type_id: j.listing_type_id ?? null,\n      international_delivery_mode: j.international_delivery_mode ?? null,\n      tier: j.tier ?? null,\n      inventory_id: j.inventory_id ?? null,\n      official_store_id: j.official_store_id ?? null,\n      original_price: j.original_price ?? null,\n      user_product_id: j.user_product_id ?? null,\n      min_purchase_unit: j.min_purchase_unit ?? null,\n\n      shipping_free_shipping: j.shipping?.free_shipping ?? null,\n      shipping_store_pick_up: j.shipping?.store_pick_up ?? null,\n      shipping_local_pick_up: j.shipping?.local_pick_up ?? null,\n      shipping_mode: j.shipping?.mode ?? null,\n      shipping_logistic_type: j.shipping?.logistic_type ?? null,\n\n      tags: j.tags ?? [],\n      deal_ids: j.deal_ids ?? [],\n      shipping_tags: j.shipping?.tags ?? [],\n      seller_address: j.seller_address ?? {},\n      sale_terms: j.sale_terms ?? [],\n      raw_json: j\n    }\n  };\n});"
      },
