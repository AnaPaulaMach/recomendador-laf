# Plantilla de pipeline/despliegue: no copiar para la demostración sin credenciales.
# Instalación local y precedencia: docs/INICIO_RAPIDO.md.
# webapp/.env y las variables del proceso prevalecen sobre este archivo en Django.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-o-anon-key
DATASET_KEY=cafe_top20_demo_2026

# Opcional: solo si queres usar src/03_llm_suggestions.py
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano
OPENAI_FALLBACK_MODEL=gpt-5-nano

# --- Interfaz web (webapp/) en despliegue. En desarrollo local no hace falta nada de esto.
DJANGO_SECRET_KEY=generar-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mi-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-app.up.railway.app
DJANGO_BEHIND_PROXY=1
# URL interna del evaluador LAF (en Railway: http://<nombre-del-servicio>.railway.internal:8080/api/graph)
LAF_API_URL=http://laf-api:8080/api/graph
# Sin estas dos la app genera programas pero NO consulta al evaluador ni publica ranking.
RECOMMENDATION_EVALUATOR=recommender.services.evaluators.LAFHttpRecommendationEvaluator
LAF_API_RESULTS_VALIDATED=1
