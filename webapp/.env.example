# Django local. Reemplazar por un valor largo en producción.
# Este archivo prevalece sobre el .env de la raíz; el entorno del proceso prevalece
# sobre ambos. Modos de demostración y evaluación real: ../docs/INICIO_RAPIDO.md.
DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Los fixtures siguen en demostración; los snapshots reales generan LAF 1 y 2.
RECOMMENDATION_EVALUATOR=recommender.services.evaluators.LAF1PreparedRecommendationEvaluator

# Integración opcional con el backend Java de LAF en Docker Desktop.
# Para probar la conexión, cambiar RECOMMENDATION_EVALUATOR por:
# recommender.services.evaluators.LAFHttpRecommendationEvaluator
LAF_API_URL=http://127.0.0.1:8088/api/graph
LAF_API_TIMEOUT_SECONDS=30

# Compuerta metodológica. Con 0 la app genera y guarda los programas LAF pero NO
# publica ningún ranking (la pantalla dice que el catálogo no puede ordenarse).
# Con 1 publica el ranking del evaluador HTTP. Se deja en 0 a propósito: quien
# instale debe ponerla en 1 a sabiendas, con laf-api corriendo. La validación que
# autoriza el 1 está registrada en docs/EVALUATOR_CONTRACT.md (2026-08-28) y se
# repitió tras el recongelado del 2026-09-10 (interfaz = batería 18/18, 126/126).
LAF_API_RESULTS_VALIDATED=0

# Ranking de productos: LAF evalúa cada aspecto y esta función aplica después
# los pesos del usuario. Usar legacy_min sólo para reproducir el modelo anterior.
LAF_PRODUCT_DECISION_MODEL=post_laf_multicriteria_v1

# Fuente opcional. La aplicación funciona sin estas variables.
SUPABASE_URL=
SUPABASE_KEY=

# Respaldo con el fixture de demostración (fixtures/cafe.json: 4 productos con
# valores ilustrativos que NO salen de laf-api). Ausente o 0: si Supabase no está
# configurado o no responde, la portada dice «No se pudo conectar con la base de
# datos» y no muestra datos. Con 1 se ofrece el fixture rotulado «demostración»
# (solo para desarrollo local sin base). En producción (Railway) dejarla sin definir.
# La suite de tests la habilita por defecto.
# ALLOW_DEMO_FIXTURE=1   # solo para demos sin base de datos; dejar comentado en producción y al correr los tests
QUALITY_ASPECT_CACHE_SECONDS=300
DATASET_KEY=cafe_top20_demo_2026

# Límite duro inicial del subgrafo visible (máximo admitido: 250).
GRAPH_VISIBLE_NODE_LIMIT=250
